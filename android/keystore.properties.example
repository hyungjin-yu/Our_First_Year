# 릴리스 서명 설정 템플릿.
#
# 1) 아래 명령으로 본인이 직접 키스토어를 생성하세요 (이 파일이나 키스토어 자체는
#    절대 git에 커밋하지 마세요 — 분실 시 Play Store에서 같은 앱을 더 이상
#    업데이트할 수 없게 됩니다. 비밀번호는 password manager 등에 안전하게 보관):
#
#    keytool -genkeypair -v -keystore release.keystore -alias our_first_year \
#      -keyalg RSA -keysize 2048 -validity 10000
#
#    (android/ 디렉토리에서 실행하면 이 파일의 RELEASE_STORE_FILE 기본값과 경로가 맞습니다)
#
# 2) 이 파일을 같은 위치에 "keystore.properties"라는 이름으로 복사하고 값을 채우세요.
#    keystore.properties는 .gitignore에 이미 등록되어 있어 커밋되지 않습니다.

RELEASE_STORE_FILE=release.keystore
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=our_first_year
RELEASE_KEY_PASSWORD=
